{
  "name": "agentic-command-center",
  "productName": "Agentic Command Center",
  "version": "1.0.0",
  "description": "An agentic development command center for your projects, Claude Code usage, and GitHub activity",
  "main": "./out/main/index.js",
  "author": "jashan",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  },
  "build": {
    "appId": "com.jashan.agenticcommandcenter",
    "productName": "Agentic Command Center",
    "files": ["out/**/*", "package.json"],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  }
}
