{
  "name": "agentic-command-center",
  "productName": "Agentic Command Center",
  "version": "1.6.1",
  "description": "An agentic development command center for your projects, Claude Code usage, and GitHub activity",
  "main": "./out/main/index.js",
  "author": "jashan",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build:helper && electron-vite dev",
    "build": "electron-vite build",
    "build:helper": "bash scripts/build-helper.sh",
    "preview": "electron-vite preview",
    "dist": "npm run build:helper && electron-vite build && electron-builder --mac",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "fix:electron": "bash scripts/fix-dev-electron.sh"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.jashan.agenticcommandcenter",
    "productName": "Agentic Command Center",
    "afterPack": "scripts/adhoc-sign.cjs",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Used to read today's calendar, list your open terminal windows, and focus the terminal you click in the terminals panel."
      }
    }
  }
}
